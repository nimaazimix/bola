{
  "name": "@bola/contracts",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0"
  },
  "exports": {
    "./*": {
      "types": "./src/*/index.ts",
      "import": "./src/*/index.ts",
      "default": "./dist/*/index.js"
    }
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@bola/eslint-config": "workspace:*",
    "@bola/typescript-config": "workspace:*",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3"
  }
}
